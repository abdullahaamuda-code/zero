# Zero Environment Configuration Example
# Copy to .env and configure your keys

# --- STT (Speech-to-Text) ---
# Ultra-fast cloud transcription via Groq Whisper LPU (~300ms)
GROQ_API_KEY=your_groq_api_key_here

# --- LLM Providers / Gateways ---
# If using direct provider APIs:
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# If using a custom LLM Gateway (e.g., Cupbearer, LiteLLM, OpenRouter):
# LLM_GATEWAY_URL=http://localhost:8000/v1
# LLM_GATEWAY_KEY=your_gateway_key_here

# --- Optional Premium TTS (ElevenLabs) ---
# Only needed if tts_engine is set to "elevenlabs" in backtalk.json
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Optional Custom Memory Vault Path ---
# ZERO_VAULT=./vault
